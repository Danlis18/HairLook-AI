# App
NODE_ENV=production
APP_URL=https://premium-hairstyles.com
SESSION_SECRET=replace-with-64-random-characters
DEMO_MODE=false
TRUST_PROXY=1
SITE_LOCALE=pt-BR

# Brand / merchant-facing values
PRODUCT_NAME=PremiumHairstyles AI
SUPPORT_EMAIL=support@mail.premium-hairstyle.com
SUPPORT_PHONE=+55 11 99999-9999
LEGAL_BUSINESS_NAME=Your Legal Business Name
LEGAL_BUSINESS_ADDRESS=Your real business address

# Display prices
PRICE_DISPLAY_USD=6.99
COMPARE_AT_PRICE_USD=24.99
PRICE_DISPLAY_BRL=36.49
COMPARE_AT_PRICE_BRL=129.90
GENERATION_TARGET_COUNT=30

# Supabase (server-side secret key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ORIGINAL_BUCKET=hair-originals
SUPABASE_RESULTS_BUCKET=hair-results

# Direct USDT checkout
# Public receiving addresses only. NEVER put seed phrases/private keys in Railway or the codebase.
CRYPTO_PRICE_USDT=6.99
CRYPTO_INTENT_TTL_MINUTES=30
# Maximum accepted fee difference. The unique 4-decimal order tag must still match.
CRYPTO_PAYMENT_TOLERANCE_USDT=1.00
CRYPTO_TRC20_ADDRESS=TMS2rDhMQi5emHGQ2ixoyfMgjabryZTLJW
CRYPTO_ERC20_ADDRESS=0x16420e2a9aa8c4ca89b328ef36c1120e67607d81
CRYPTO_BEP20_ADDRESS=0x16420e2a9aa8c4ca89b328ef36c1120e67607d81
CRYPTO_AUTO_VERIFY=true
CRYPTO_ERC20_CONFIRMATIONS=3
CRYPTO_BEP20_CONFIRMATIONS=5

# Read-only blockchain explorer/API credentials used to confirm incoming transfers.
# Do not use an exchange API key and do not grant withdrawal/trading permissions.
TRONGRID_API_KEY=replace-with-trongrid-api-key
ETHERSCAN_API_KEY=replace-with-etherscan-api-key
# Optional but recommended for BEP20. Without it, BscScan keyless requests are heavily rate-limited.
BSCSCAN_API_KEY=replace-with-bscscan-api-key

# Meta Ads measurement
# META_PIXEL_ID / dataset ID is public and may be exposed to the browser.
META_PIXEL_ID=replace-with-meta-pixel-id
# Server-only Conversions API access token. Keep only in Railway variables.
META_CONVERSIONS_API_TOKEN=replace-with-meta-capi-access-token
# Optional while testing in Events Manager. Remove/empty it before normal production attribution.
META_TEST_EVENT_CODE=
# Optional. Leave empty to use Meta's unversioned Graph endpoint, or set the version shown in your Meta setup.
META_GRAPH_API_VERSION=

# Current fulfillment mode
# Flow: quiz -> photo -> email verification -> USDT invoice -> on-chain confirmation -> preparation -> email delivery in up to 15 minutes.
MANUAL_FULFILLMENT_MODE=true
GENERATION_ENABLED=false

# Customer email verification
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Resend HTTPS API for transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=PremiumHairstyles AI <verify@mail.your-domain.com>

# Auth / admin
ADMIN_EMAILS=owner@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-password
MAGIC_LINK_TTL_MINUTES=20
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Upload / privacy
MAX_UPLOAD_MB=12
ORIGINAL_RETENTION_HOURS=720
RESULT_RETENTION_DAYS=30
SIGNED_URL_TTL_SECONDS=300
IP_HASH_SALT=replace-with-random-salt

# Operational flags
CHECKOUT_ENABLED=true
MAINTENANCE_MODE=false
LOG_LEVEL=info

# OPTIONAL - future automatic generation. Dormant in current manual mode.
AI_PROVIDER=replicate
REPLICATE_API_TOKEN=
AI_PRIMARY_MODEL=black-forest-labs/flux-kontext-pro
AI_ESTIMATED_COST_USD=0.04
GENERATION_WORKER_CONCURRENCY=2
GENERATION_POLL_INTERVAL_MS=2500

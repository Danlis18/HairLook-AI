# App
NODE_ENV=production
# Railway injects PORT automatically; do not set PORT there unless you have a specific reason.
APP_URL=https://your-domain.com
SESSION_SECRET=replace-with-64-random-characters
DEMO_MODE=false
TRUST_PROXY=1

# Brand / merchant-facing values
PRODUCT_NAME=HairLook AI
SUPPORT_EMAIL=support@your-domain.com
LEGAL_BUSINESS_NAME=Your Legal Business Name
LEGAL_BUSINESS_ADDRESS=Your business address
PRICE_DISPLAY_USD=15.00
GENERATION_TARGET_COUNT=30

# Supabase (server-side secret key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ORIGINAL_BUCKET=hair-originals
SUPABASE_RESULTS_BUCKET=hair-results

# Paddle checkout (REQUIRED)
# Use sandbox + a test_ client token while testing. Switch both environment and token for live.
PAYMENT_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxx
PADDLE_PRICE_ID=pri_xxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxx
# OPTIONAL: not used by the current Paddle.js checkout/webhook flow.
PADDLE_API_KEY=

# Current fulfillment mode
# Customer flow: quiz -> photo -> email -> 6-digit email verification -> Paddle checkout.
# After a verified transaction.completed webhook the order becomes manual_pending.
# You manually create and send results within 72 hours. No AI worker is required.
MANUAL_FULFILLMENT_MODE=true
GENERATION_ENABLED=false

# Customer email verification (REQUIRED in production)
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Resend HTTPS API for verification emails.
# Use HTTPS API instead of SMTP so it works on Railway plans where outbound SMTP is restricted.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=HairLook AI <verify@mail.your-domain.com>

# Auth / admin
ADMIN_EMAILS=owner@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-password
MAGIC_LINK_TTL_MINUTES=20
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Upload / privacy
MAX_UPLOAD_MB=12
# 30 days so paid customer originals remain available for manual fulfillment.
ORIGINAL_RETENTION_HOURS=720
RESULT_RETENTION_DAYS=30
SIGNED_URL_TTL_SECONDS=300
IP_HASH_SALT=replace-with-random-salt

# Operational flags
CHECKOUT_ENABLED=true
MAINTENANCE_MODE=false
LOG_LEVEL=info

# OPTIONAL - future automatic AI generation. Dormant in current manual mode.
AI_PROVIDER=replicate
REPLICATE_API_TOKEN=
AI_PRIMARY_MODEL=black-forest-labs/flux-kontext-pro
AI_ESTIMATED_COST_USD=0.04
GENERATION_WORKER_CONCURRENCY=2
GENERATION_POLL_INTERVAL_MS=2500

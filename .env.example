# App
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
SESSION_SECRET=replace-with-64-random-characters
DEMO_MODE=false
TRUST_PROXY=1

# Brand / merchant-facing values
PRODUCT_NAME=HairLook AI
SUPPORT_EMAIL=support@your-domain.com
LEGAL_BUSINESS_NAME=Your Legal Business Name
LEGAL_BUSINESS_ADDRESS=Your business address
PRICE_DISPLAY_USD=15.00
GENERATION_TARGET_COUNT=30

# Supabase (use 2026 publishable/secret keys; this app only needs the secret server-side key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ORIGINAL_BUCKET=hair-originals
SUPABASE_RESULTS_BUCKET=hair-results

# PayPro Global hosted checkout (REQUIRED)
PAYPRO_PRODUCT_ID=
PAYPRO_PAGE_TEMPLATE_ID=
PAYPRO_SECRET_KEY=
PAYPRO_VALIDATION_KEY=
PAYPRO_TEST_MODE=true
PAYPRO_CURRENCY=USD
PAYPRO_LANGUAGE=EN

# OPTIONAL - only if you later add PayPro REST API methods (not used by this app today)
PAYPRO_VENDOR_ACCOUNT_ID=
PAYPRO_API_SECRET_KEY=

# Manual fulfillment (current mode): Supabase + PayPro Global + a human uploading results.
# AI_*, REPLICATE_*, GENERATION_WORKER_* below are OPTIONAL and dormant while this is true -
# no worker process is required to run. Flip this off later if/when automatic AI
# generation (Replicate + the worker service) is reintroduced.
MANUAL_FULFILLMENT_MODE=true

# OPTIONAL - AI (only relevant if MANUAL_FULFILLMENT_MODE=false and the worker is deployed)
AI_PROVIDER=replicate
REPLICATE_API_TOKEN=
AI_PRIMARY_MODEL=black-forest-labs/flux-kontext-pro
# Optional accounting estimate; update when provider pricing changes.
AI_ESTIMATED_COST_USD=0.04
GENERATION_WORKER_CONCURRENCY=2
GENERATION_POLL_INTERVAL_MS=2500

# Customer email verification (6-digit OTP sent by email before checkout is allowed).
# When true, SMTP_* + EMAIL_FROM below become REQUIRED - the server refuses to start in
# production without them, since verification cannot silently work without real email delivery.
# Set to false only for local/dev/manual testing to bypass verification.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Email (SMTP). REQUIRED when EMAIL_VERIFICATION_ENABLED=true (see above). Otherwise optional -
# admin magic-link sign-in and result-ready emails are simply skipped and logged
# (email_skipped_smtp_not_configured) when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HairLook AI <results@your-domain.com>

# Auth / admin (REQUIRED in manual fulfillment mode)
ADMIN_EMAILS=owner@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-password
MAGIC_LINK_TTL_MINUTES=20
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Upload / privacy
MAX_UPLOAD_MB=12
ORIGINAL_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=30
SIGNED_URL_TTL_SECONDS=300
IP_HASH_SALT=replace-with-random-salt

# Operational flags
CHECKOUT_ENABLED=true
GENERATION_ENABLED=true
MAINTENANCE_MODE=false
LOG_LEVEL=info

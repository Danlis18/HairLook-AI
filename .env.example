# App
NODE_ENV=production
APP_URL=https://your-domain.com
SESSION_SECRET=replace-with-64-random-characters
DEMO_MODE=false
TRUST_PROXY=1
SITE_LOCALE=pt-BR

# Brand / merchant-facing values shown on product/legal/support pages
PRODUCT_NAME=PremiumHairstyles AI
SUPPORT_EMAIL=support@your-domain.com
# Strongly recommended before Paddle website review: publish a real customer-support phone number.
SUPPORT_PHONE=+55 11 99999-9999
LEGAL_BUSINESS_NAME=Your Legal Business Name
LEGAL_BUSINESS_ADDRESS=Your real business address

# Preserved English/USD offer (saved separately on branch english-usd-snapshot)
PRICE_DISPLAY_USD=6.99
COMPARE_AT_PRICE_USD=24.99

# Active Brazil offer
# 6.99 USD was approximately R$36.50 at the time this Brazil storefront was prepared.
PRICE_DISPLAY_BRL=36.50
COMPARE_AT_PRICE_BRL=129.90
GENERATION_TARGET_COUNT=30

# Supabase (server-side secret key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_ORIGINAL_BUCKET=hair-originals
SUPABASE_RESULTS_BUCKET=hair-results

# Paddle checkout (REQUIRED)
PAYMENT_PROVIDER=paddle
# Live: production + live_ client token + LIVE notification secret.
PADDLE_ENVIRONMENT=production
PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxx
# English/USD price kept for future locale routing
PADDLE_PRICE_ID=pri_usd_xxxxxxxxxxxxxxxxxxxxx
# ACTIVE Brazil price. Create a one-time BRL price in Paddle and place its pri_ ID here.
PADDLE_PRICE_ID_BR=pri_brl_xxxxxxxxxxxxxxxxxxxxx
# OPTIONAL: backend-only, not exposed to Paddle.js.
PADDLE_API_KEY=pdl_live_apikey_xxxxxxxxxxxxxxxxx

# Current fulfillment mode
# Flow: quiz -> photo -> email -> 6-digit verification -> Paddle checkout -> manual preparation -> email delivery within 72h.
MANUAL_FULFILLMENT_MODE=true
GENERATION_ENABLED=false

# Customer email verification
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Resend HTTPS API for transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=PremiumHairstyles AI <verify@mail.your-domain.com>

# Auth / admin
ADMIN_EMAILS=owner@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-password
MAGIC_LINK_TTL_MINUTES=20
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Upload / privacy
MAX_UPLOAD_MB=12
ORIGINAL_RETENTION_HOURS=720
RESULT_RETENTION_DAYS=30
SIGNED_URL_TTL_SECONDS=300
IP_HASH_SALT=replace-with-random-salt

# Operational flags
CHECKOUT_ENABLED=true
MAINTENANCE_MODE=false
LOG_LEVEL=info

# OPTIONAL - future automatic generation. Dormant in current manual mode.
AI_PROVIDER=replicate
REPLICATE_API_TOKEN=
AI_PRIMARY_MODEL=black-forest-labs/flux-kontext-pro
AI_ESTIMATED_COST_USD=0.04
GENERATION_WORKER_CONCURRENCY=2
GENERATION_POLL_INTERVAL_MS=2500
